# Assistant (OpenAI-compatible provider)
CHAT_API_KEY=
CHAT_BASE_URL=https://freemodel.in/v1
CHAT_MODEL=

# Support tokens (email). Use Resend, or leave empty to fall back to FormSubmit.
RESEND_API_KEY=
SUPPORT_TO=densee.ai@gmail.com
SUPPORT_FROM=Dense AI <onboarding@resend.dev>

# Live handoff state (Upstash Redis). Without these, state is kept in memory only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin console (/admin). Set all three in production.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DENSE_MEET_URL=
